# Copy to .env and enter unique local development passwords. Never commit .env.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
# First-run setup creates real accounts in an empty installation.
APP_SETUP_ENABLED=true
# Persistent random 64-hex key, required for authenticator and webhook signing secrets.
APP_ENCRYPTION_KEY=
# Exact public HTTPS hostnames permitted for outgoing webhook callbacks.
APP_WEBHOOK_ALLOWED_HOSTS=
# Optional real malware scanner. Otherwise documents remain quarantined pending independent review.
APP_CLAMAV_HOST=
APP_CLAMAV_PORT=3310
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APP_MAIL_FROM=enterpriseos@localhost
# Optional pre-provisioned private S3-compatible document bucket. Empty endpoint keeps local storage.
APP_OBJECT_STORAGE_ENDPOINT=
APP_OBJECT_STORAGE_BUCKET=
APP_OBJECT_STORAGE_REGION=us-east-1
APP_OBJECT_STORAGE_ACCESS_KEY=
APP_OBJECT_STORAGE_SECRET_KEY=
APP_OBJECT_STORAGE_SESSION_TOKEN=
APP_OBJECT_STORAGE_ALLOW_HTTP=false
